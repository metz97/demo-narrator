# Copy to .env — demo-narrator loads it automatically. NEVER commit .env.

# Stage 3, only when claude.mode = api_key (the default agent_sdk mode uses
# your Claude Code login / subscription instead).
ANTHROPIC_API_KEY=

# Stage 4, only when tts.provider = elevenlabs.
ELEVENLABS_API_KEY=

# Stage 2, only for --sprint / --task. Azure DevOps Personal Access Token
# with "Work Items (Read)" scope. OPTIONAL: leave blank to use your local
# `az login` (Entra ID) session instead.
AZURE_DEVOPS_EXT_PAT=

# ── Playwright demo mode (project: lca-tool) ─────────────────────────────────
# App login credentials, consumed by the profile's auth.login_recipe.
# IMPORTANT: use a DEDICATED TEST ACCOUNT without MFA (the login is automated
# and cannot pass a 2FA prompt) — the same kind of account QA uses for e2e.
E2E_CORE_USERNAME=
E2E_CORE_PASSWORD=

# Optional overrides (defaults live in profiles/lca-tool.yaml).
# LCA_BASE_URL=http://localhost:4201
# Path where the captured/authenticated session is stored & reused:
# LCA_STORAGE_STATE=C:/project/nbs/lca-tool/apps/lca-tool/playwright-e2e/.auth/core.json

# Extra Chromium flags for the login launches. Needed when the IdP pins the
# client's redirect_uri to an origin the app no longer serves: run
# `make callback-shim` (127.0.0.1:4200 -> :4201) and make the login browser
# resolve the pinned host to it. Quote values containing spaces.
# DEMO_NARRATOR_BROWSER_ARGS='--host-resolver-rules="MAP localhost:4200 127.0.0.1:4200"'
